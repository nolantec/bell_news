# ====== 邮件服务配置 ======
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_auth_code
MAIL_TO=recipient@example.com

# ====== 定时配置（每天7:00 北京时间） ======
SCHEDULE=0 0 7 * * *

# ====== 国内新闻关键词（中文，逗号分隔） ======
NEWS_DOMESTIC_KEYWORDS=汽车膜,隐形车衣,漆面保护膜,车窗膜,隔热膜,改色膜,TPU车衣,汽车窗膜,车身改色膜,汽车打印膜

# ====== 国际新闻关键词（英文，逗号分隔） ======
NEWS_INTL_KEYWORDS=paint protection film,automotive window film,car wrap,PPF automotive

# ====== DeepSeek AI 摘要（可选，不填则无 AI 摘要） ======
# 注册地址: https://platform.deepseek.com
# 价格极低（约 ¥1/百万 token），推荐配置
DEEPSEEK_API_KEY=

# ====== Tavily Search API（可选，用于解析新闻真实链接） ======
# 注册地址: https://app.tavily.com
# 免费层 1000次/月，足够每日使用
TAVILY_API_KEY=
